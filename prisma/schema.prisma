// Crescent Moon admin backend — data model.
// One database (Postgres) for the whole admin app. cal.diy and Plausible keep
// their OWN separate databases; we never touch those schemas — we read cal.diy
// over its API only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 1 — the single boss login. There is intentionally only ever one row.
// ---------------------------------------------------------------------------
model AdminUser {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  stockResolved StockReport[]
}

// ---------------------------------------------------------------------------
// Phase 2 — "What's On" CMS entries. The public homepage renders these live.
// ---------------------------------------------------------------------------
model WhatsOnEntry {
  id          String   @id @default(cuid())
  // e.g. "Soul Night"
  title       String
  // e.g. "Records, low light, no rush."
  description String
  // The frequency label shown on the left, e.g. "Sundays" / "Monthly" / "Dates vary".
  schedule    String
  // Optional concrete date for one-off events.
  date        DateTime?
  active      Boolean  @default(true)
  // Lower sortOrder shows first.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

// ---------------------------------------------------------------------------
// Phase 3 — rota. Staff members + their shifts. We keep history: deactivating
// a staff member never deletes past shifts.
// ---------------------------------------------------------------------------
model StaffMember {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  // Ordering down the side of the grid.
  sortOrder Int      @default(0)
  // --- Staff app PIN (phase: per-staff PIN auth) --------------------------
  // The PIN *is* the identity in the staff app: four digits, no name picker.
  // bcrypt salts per row, so a hash alone can't be looked up without looping
  // every staff member. Hence two columns:
  //   pinLookup — HMAC-SHA256(pin, STAFF_PIN_SECRET). Indexed + unique, so one
  //               query finds the person and two staff can never share a PIN.
  //   pinHash   — bcrypt, verified after the lookup.
  pinLookup String?   @unique
  pinHash   String?
  pinSetAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shifts    Shift[]

  // Everything done in the staff app is signed by a real person, so these are
  // real foreign keys rather than loose id strings.
  checksTicked  ChecklistCheck[] @relation("ChecklistCheckedBy")
  runsSubmitted ChecklistRun[]   @relation("ChecklistSubmittedBy")
  stockReports  StockReport[]    @relation("StockReportedBy")
  timeEntries   TimeEntry[]

  @@index([active, sortOrder])
}

// Rate limiting for the staff app keypad: three tries, then the pad parks for
// 60 seconds. Counted per slug and kept in the database, not in memory — a
// Coolify restart would otherwise hand an attacker a fresh three tries.
model StaffPinThrottle {
  slug        String    @id
  failures    Int       @default(0)
  lastFailAt  DateTime?
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

enum ShiftKind {
  WORKING // an actual time range with hours
  CLOSED // venue closed that day
  UNAVAILABLE // staff not available
  HOLIDAY // on holiday (optionally a range via holidayEnd)
}

model Shift {
  id            String      @id @default(cuid())
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id])
  staffMemberId String
  // The calendar day this cell belongs to (date-only; time lives in start/end).
  date          DateTime    @db.Date
  kind          ShiftKind   @default(WORKING)
  // For WORKING shifts: stored as minutes-from-midnight so hours math is exact.
  startMinutes  Int?
  endMinutes    Int?
  // For HOLIDAY spanning multiple days.
  holidayEnd    DateTime?   @db.Date
  // "shift 1" / "shift 2" split-shift ordering within a single day.
  slot          Int         @default(1)
  // Free text like "CCC", "TBC", "1st England Game".
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([date])
  @@index([staffMemberId, date])
}

// Per-day header note on the rota, e.g. "1st England Game" — matches the notes
// the Excel sheet puts in the day header row.
model DayNote {
  date DateTime @id @db.Date
  note String
}

// ---------------------------------------------------------------------------
// Staff app — the lockdown checklist. One run per trading night, ticked by
// whoever is closing, then submitted and locked. A manager can reopen it.
// ---------------------------------------------------------------------------

// Boss-editable, like the What's On CMS. `section` is free text — "Bar",
// "Floor", "Security" today, whatever the room needs tomorrow. Sections appear
// in the order of their first item, so ordering items orders the groups.
model ChecklistItem {
  id        String           @id @default(cuid())
  label     String
  section   String
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  checks    ChecklistCheck[]

  @@index([active, sortOrder])
}

model ChecklistRun {
  // The trading night, not the calendar day — a run submitted at 00:12 belongs
  // to the night before. See src/lib/business-date.ts; unique, so a night can
  // never split into two rows at midnight.
  businessDate  DateTime         @id @db.Date
  submittedAt   DateTime?
  submittedBy   StaffMember?     @relation("ChecklistSubmittedBy", fields: [submittedById], references: [id])
  submittedById String?
  reopenedAt    DateTime?
  createdAt     DateTime         @default(now())
  checks        ChecklistCheck[]

  @@index([submittedAt])
}

model ChecklistCheck {
  id          String        @id @default(cuid())
  run         ChecklistRun  @relation(fields: [runDate], references: [businessDate], onDelete: Cascade)
  runDate     DateTime      @db.Date
  item        ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  // Who ticked it, and when. Never inferred, never blank.
  checkedBy   StaffMember   @relation("ChecklistCheckedBy", fields: [checkedById], references: [id])
  checkedById String
  checkedAt   DateTime      @default(now())
  // A note here escalates to the manager once the night is submitted.
  note        String?

  @@unique([runDate, itemId])
  @@index([runDate])
}

// ---------------------------------------------------------------------------
// Staff app — low stock. Staff flag what's running out; the boss works through
// the open ones and resolves them. It is a list, not an order.
// ---------------------------------------------------------------------------

// Seeded from the live menu (scripts/seed-stock.ts reads src/lib/menu-template.ts),
// so the names on the pad are the names on the list. Off-menu things — tonic,
// till roll, blue roll — never become rows here: they go through the free-text
// row on the report screen.
model StockItem {
  id        String        @id @default(cuid())
  name      String
  category  String
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  reports   StockReport[]

  @@index([active, sortOrder])
}

enum StockLevel {
  LOW
  OUT
}

model StockReport {
  id           String      @id @default(cuid())
  // Either a menu item or a line of free text — never both, never neither.
  item         StockItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId       String?
  freeText     String?
  level        StockLevel
  note         String?
  // Signed with the PIN that was in when it was reported.
  reportedBy   StaffMember @relation("StockReportedBy", fields: [reportedById], references: [id])
  reportedById String
  createdAt    DateTime    @default(now())
  // Resolving is the boss's act, in the admin area.
  resolvedAt   DateTime?
  resolvedBy   AdminUser?  @relation(fields: [resolvedById], references: [id])
  resolvedById String?

  @@index([resolvedAt, createdAt])
  @@index([itemId, resolvedAt])
}

// ---------------------------------------------------------------------------
// Staff app — clock in / out. Entirely optional: nobody is chased for it, and
// the rota is still what gets paid. This is a record of what happened, not an
// authority on what's owed.
// ---------------------------------------------------------------------------

model TimeEntry {
  id          String      @id @default(cuid())
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     String
  clockInAt   DateTime
  clockOutAt  DateTime?
  // Closed by reconciliation rather than by the person — at their rota end
  // where there was one, or at a cap where there wasn't. Nobody is told off
  // for it; the boss just sees which entries weren't closed by hand.
  autoClosed  Boolean     @default(false)
  adminEdited Boolean     @default(false)
  note        String?

  @@index([staffId, clockInAt])
  @@index([clockOutAt])
}

// ---------------------------------------------------------------------------
// Push — the boss's device(s) only.
//
// The staff app has no push, no badges and no counts, and that rule is
// absolute. This is a different surface for a different audience: one person,
// who asked for it, about stock they need to order.
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Which browser it came from, so the boss can tell two devices apart.
  label     String?
  createdAt DateTime @default(now())
  lastSentAt DateTime?
}

// ---------------------------------------------------------------------------
// Key/value settings the boss controls, e.g. the staff-app slug and the room's
// phone number.
// ---------------------------------------------------------------------------
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
