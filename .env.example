# ---------------------------------------------------------------------------
# Crescent Moon admin app — environment variables.
# Copy to .env and fill in. In Coolify these are set in the app's Environment tab.
# ---------------------------------------------------------------------------

# Postgres for THIS app (not cal.diy's DB, not Plausible's DB).
# In Coolify, provision a Postgres and paste its connection string here.
DATABASE_URL="postgresql://crmn:crmn@127.0.0.1:5433/crmn?schema=public"

# Secret used to sign the boss's session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Keys the staff app's PIN lookup column (HMAC-SHA256 of each PIN). Generate the
# same way as SESSION_SECRET. If unset it falls back to SESSION_SECRET; changing
# either one invalidates every stored PIN, so they'd all need setting again.
STAFF_PIN_SECRET=""

# The admin login created on first deploy, by the seed that `npm run build` runs
# (scripts/deploy-bootstrap.mjs). In production ADMIN_INITIAL_PASSWORD is
# REQUIRED for that login to be created at all — the seed refuses to fall back to
# a password published in this repo. Both are only read when no admin row exists
# yet; changing them later does nothing (use `npm run set-password`).
ADMIN_EMAIL="boss@crescentmoonbar.co.uk"
ADMIN_INITIAL_PASSWORD=""

# Public base URL of this site (used for absolute links, robots, etc.).
# Note: the staff-app link shown in the admin area does NOT use this — it is
# built from the incoming request's host so it is right on every deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Phase 4: cal.diy booking integration (fill in once cal.diy is deployed) ---
# API base of your self-hosted cal.diy instance. We call {CAL_API_URL}/v2/bookings,
# and cal.diy rewrites /api/v2/* to /v2/*, so either form works — with or without
# the /api suffix.
CAL_API_URL="https://cal.crescentmoonbar.example"
# cal.diy API key — created in cal.diy → Settings → Developer → API keys. It is
# sent as "Authorization: Bearer <key>" and the v2 API expects the cal_ prefix
# the key is issued with. (cal.diy ships only the v2 API; there is no v1.)
CAL_API_KEY="cal_..."
# The event-type id/slug representing "table reservation".
# NOTE: nothing in src/ reads this today — the widget addresses the event type by
# its public slug in NEXT_PUBLIC_CAL_BOOKING_LINK instead.
CAL_EVENT_TYPE_ID=""
# Public origin of cal.diy (no /api), used by the website booking button.
NEXT_PUBLIC_CAL_URL_BASE="https://cal.crescentmoonbar.example"
# Public booking page slug the widget opens, e.g. "crescentmoon/table".
#
# The reservation event type in cal.diy needs "multiple durations" turned on,
# including 90 minutes, or the &duration=90 the widget sends is ignored and every
# table is held for the event type's fixed length instead. Verified against a
# running cal.diy: a 60-minute event type with no multiple-duration setting books
# 60 minutes and drops the request silently; adding 60/90/120 makes the same URL
# book the 90 the website promises.
NEXT_PUBLIC_CAL_BOOKING_LINK=""

# --- Phase 5: Plausible analytics (fill in once Plausible is deployed) ---
# Base URL of your self-hosted Plausible instance.
NEXT_PUBLIC_PLAUSIBLE_URL="https://plausible.crescentmoonbar.example"
# The domain registered in Plausible for this site.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="crescentmoonbar.vercel.app"
# A Plausible "shared link" URL (Site Settings → Visibility) for the admin embed.
PLAUSIBLE_SHARED_LINK=""

# --- Push notifications (boss's admin app only; the staff app has none) ---
# Generate a keypair once with:  npm run vapid
# Changing these invalidates every device subscription.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact the push service can reach you on, per RFC 8292.
VAPID_SUBJECT="mailto:boss@crescentmoonbar.co.uk"
