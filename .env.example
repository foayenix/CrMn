# ---------------------------------------------------------------------------
# Crescent Moon admin app — environment variables.
# Copy to .env and fill in. In Coolify these are set in the app's Environment tab.
# ---------------------------------------------------------------------------

# Postgres for THIS app (not cal.diy's DB, not Plausible's DB).
# In Coolify, provision a Postgres and paste its connection string here.
DATABASE_URL="postgresql://crmn:crmn@127.0.0.1:5433/crmn?schema=public"

# Secret used to sign the boss's session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Public base URL of this site (used for absolute links, robots, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Phase 4: cal.diy booking integration (fill in once cal.diy is deployed) ---
# API base of your self-hosted cal.diy instance (note the /api suffix).
CAL_API_URL="https://cal.crescentmoonbar.example/api"
# cal.diy API key (v1) — created in cal.diy → Settings → Developer → API keys.
CAL_API_KEY=""
# The event-type id/slug representing "table reservation".
CAL_EVENT_TYPE_ID=""
# Public origin of cal.diy (no /api), used by the website booking button.
NEXT_PUBLIC_CAL_URL_BASE="https://cal.crescentmoonbar.example"
# Public booking page slug the widget opens, e.g. "crescentmoon/table".
NEXT_PUBLIC_CAL_BOOKING_LINK=""

# --- Phase 5: Plausible analytics (fill in once Plausible is deployed) ---
# Base URL of your self-hosted Plausible instance.
NEXT_PUBLIC_PLAUSIBLE_URL="https://plausible.crescentmoonbar.example"
# The domain registered in Plausible for this site.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="crescentmoonbar.vercel.app"
# A Plausible "shared link" URL (Site Settings → Visibility) for the admin embed.
PLAUSIBLE_SHARED_LINK=""
